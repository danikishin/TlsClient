<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>TlsClient</AssemblyName>
    <RootNamespace>TlsClient</RootNamespace>
    <PackageId>TlsClient</PackageId>
    <Title>TlsClient</Title>
    <Version>0.6.0-preview.1</Version>
    <Authors>TlsClient contributors</Authors>
    <Copyright>Copyright © 2026 TlsClient contributors</Copyright>
    <Description>A pure managed, fingerprintable HTTP client powered by SharpTls.</Description>
    <PackageTags>tls;http;http2;hpack;fingerprint;clienthello;utls;managed</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/danikishin/TlsClient</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/danikishin/TlsClient/releases/tag/v0.6.0-preview.1</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/danikishin/TlsClient</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpTls" Version="[0.9.0-preview.5]" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../ROADMAP.md" Pack="true" PackagePath="/" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/PRESETS.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/PROFILE-MANIFEST.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/FINGERPRINT-LAB.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/ECH-DNS.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/SESSION-PERSISTENCE.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/CERTIFICATES.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/DIAGNOSTICS.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/HTTP3-EVALUATION.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/API-COMPATIBILITY.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/FUZZING.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/PERFORMANCE.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/SUPPLY-CHAIN.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/RELEASING.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/PROTOCOL-REVIEW.md" Pack="true" PackagePath="docs/" />
    <None Include="../../THREAT-MODEL.md" Pack="true" PackagePath="/" />
    <None Include="../../SECURITY.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/SUPPORTED-VERSIONS.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/CONNECTIVITY.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/STREAMING.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/RETRIES.md" Pack="true" PackagePath="docs/" />
    <None Include="../../docs/POLICIES.md" Pack="true" PackagePath="docs/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
